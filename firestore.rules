rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /users/{userId}/projects/{projectId} {
   allow read: if request.auth != null && request.auth.uid == userId;
   allow create: if request.auth != null && request.auth.uid == userId
     && request.resource.data.keys().hasOnly(['name','category','status','createdAt'])
     && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
     && request.resource.data.category == 'shoes'
     && request.resource.data.status == 'draft';
   allow update, delete: if false;
  }
 }
}
